{
  "name": "royalprep-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "dev:student": "vite --host 127.0.0.1 --mode student",
    "dev:admin": "vite --host 127.0.0.1 --mode admin",
    "build:student": "tsc --noEmit && vite build --mode student",
    "build:admin": "tsc --noEmit && vite build --mode admin",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
